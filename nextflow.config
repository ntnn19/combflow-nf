// combflow-nf configuration

params {
    // inputs (required)
    fasta               = null      // FASTA of unique chain sequences
    pdb_dir             = null      // directory with AlphaFold(-Multimer) PDB predictions
    stoichiometry       = null      // e.g. "NS1:1-2,NS2A:1-2" (chains not listed default to 1 copy)
    // outputs
    outdir              = "results"

    // prepare_subunits_json
    extra_prepare_flags = "--max-combinations 100000"        // e.g. "--max-af-size 1800 --verbose"

    // combfold assembly fan-out
    chunk_size          = 192        // combinations per COMBFOLD_ASSEMBLY task;
                                    // each task runs its chunk via GNU parallel -j $(nproc)
    combfold_cpus       = 1        // CPUs requested per task (SLURM --cpus-per-task; matches nproc)
    combfold_memory     = "4.GB"
    combfold_time       = "2400.h"

    // container
    combfold_image      = "/scratch/home/nagarnat/projects/scaturro/zika_ns5/replication_complex/combfold_v1.0.1.sif"  // ntnn19/combfold + GNU parallel + click
    combfold_home       = "/app/CombFold-master"             // CombFold install path inside the image
}

profiles {

    // nf-core style: software-stack profiles compose with executor profiles,
    // e.g.  -profile apptainer,slurm

    // --- software stack ---
    apptainer {
        apptainer.enabled     = true
        apptainer.autoMounts  = true
        apptainer.cacheDir    = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${launchDir}/apptainer_cache"
    }
    singularity {
        singularity.enabled   = true
        singularity.autoMounts = true
        singularity.cacheDir  = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${launchDir}/singularity_cache"
    }
    docker {
        docker.enabled        = true
    }
    conda {
        // PREPARE_SUBUNITS_JSON only; COMBFOLD_ASSEMBLY still requires the
        // CombFold container (compiled CombinatorialAssembler binaries).
        conda.enabled         = true
    }

    // --- executors (default is local) ---
    slurm {
        process.executor      = 'slurm'
        executor {
            name = 'slurm'
            queueSize = 1000
        }        
    }
}

process {
    withName: 'PREPARE_SUBUNITS_JSON' {
        container = null
        executor = 'slurm'
    }
}
process {
    withName: 'PREPARE_FASTAS' {
        containerOptions = "--bind ${params.pdb_dir}:${params.pdb_dir} --bind /scratch/home/nagarnat/repos/combflow-nf/prepare_fastas_parallel.py:/app/CombFold-master/scripts/prepare_fastas.py"
        executor = 'slurm'
    }
}
process {
    withName: 'MAP_FASTA_TO_PDB' {
        container = null
        executor = 'local'
    }
}
process {
    withName: 'CREATE_PDB_DIRS' {
        container = null
        executor = 'local'
    }
}
process {
    withName: 'COMBFOLD_ASSEMBLY' {
        //clusterOptions = '--exclude=cssbhpiuke025'
        executor = 'slurm'
        //errorStrategy = "ignore"
    }
}
