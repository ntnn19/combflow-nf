// combflow-nf configuration

params {
    // inputs (required)
    fasta               = null      // FASTA of unique chain sequences
    pdb_dir             = null      // directory with AlphaFold(-Multimer) PDB predictions
    stoichiometry       = null      // e.g. "NS1:1-2,NS2A:1-2" (chains not listed default to 1 copy)

    // outputs
    outdir              = "results"

    // prepare_subunits_json
    extra_prepare_flags = ""        // e.g. "--max-af-size 1800 --verbose"

    // combfold assembly fan-out
    chunk_size          = 25        // combinations per COMBFOLD_ASSEMBLY task;
                                    // each task runs its chunk via GNU parallel -j $(nproc)
    combfold_cpus       = 16        // CPUs requested per task (SLURM --cpus-per-task; matches nproc)
    combfold_memory     = "32.GB"
    combfold_time       = "24.h"

    // container
    combfold_image      = "ntnn19/combfold-parallel:latest"  // ntnn19/combfold + GNU parallel + click
                                                             // (see docker/Dockerfile)
    combfold_home       = "/app/CombFold-master"             // CombFold install path inside the image
}

profiles {

    // CSSB-style HPC: SLURM + Apptainer
    slurm_apptainer {
        process.executor      = 'slurm'
        apptainer.enabled     = true
        apptainer.autoMounts  = true
        apptainer.cacheDir    = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${launchDir}/apptainer_cache"
    }

    // single machine, Apptainer
    local_apptainer {
        process.executor      = 'local'
        apptainer.enabled     = true
        apptainer.autoMounts  = true
        apptainer.cacheDir    = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${launchDir}/apptainer_cache"
    }

    // single machine, Docker
    local_docker {
        process.executor      = 'local'
        docker.enabled        = true
    }

    // single machine, no containers: PREPARE_SUBUNITS_JSON via conda only.
    // NOTE: COMBFOLD_ASSEMBLY still requires the CombFold container
    // (compiled CombinatorialAssembler binaries) - use a container profile
    // for real runs.
    local_conda {
        process.executor      = 'local'
        conda.enabled         = true
    }
}
